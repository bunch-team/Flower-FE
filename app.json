{
  "expo": {
    "name": "Flower-FE",
    "slug": "Flower-FE",
    "version": "1.0.0",
    "orientation": "portrait",
    "backgroundColor": "#FDFBF0",
    "scheme": "flowerfe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.yjbae04.Flower-FE",
      "backgroundColor": "#FDFBF0"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.yjbae04.FlowerFE"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDFBF0",
          "image": "./assets/images/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "usePrecompiledModules": false
          }
        }
      ],
      "expo-font",
      "expo-system-ui",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
